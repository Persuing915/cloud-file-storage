PORT=5000

# MongoDB Connection URI (Choose either Local MongoDB or MongoDB Atlas)
# Option 1: Local MongoDB (default port 27017)
MONGODB_URI=mongodb://127.0.0.1:27017/cloud_file_storage

# Option 2: MongoDB Atlas Cloud (replace <username>, <password>, and <cluster-url> with your details)
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/cloud_file_storage?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# Local Uploads Directory (optional, defaults to backend/uploads)
# UPLOAD_DIR=./uploads
